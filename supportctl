#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ENV_FILE="$ROOT_DIR/.env"

usage() {
  cat <<'USAGE'
Usage:
  ./supportctl install
  ./supportctl up
  ./supportctl down
  ./supportctl status
  ./supportctl logs [service]
  ./supportctl backup
  ./supportctl init-agent
  ./supportctl site create
  ./supportctl site list
  ./supportctl site code <site_key>

V1 admin is CLI-first. Web admin is intentionally not included.
USAGE
}

require_env() {
  if [[ ! -f "$ENV_FILE" ]]; then
    echo "Missing .env. Run ./supportctl install first." >&2
    exit 1
  fi
  set -a
  # shellcheck disable=SC1090
  source "$ENV_FILE"
  set +a
}

base_url() {
  echo "${APP_BASE_URL:-http://localhost:8080}"
}

admin_token() {
  if [[ -z "${ADMIN_TOKEN:-}" || "${ADMIN_TOKEN:-}" == "change-this-long-random-admin-token" ]]; then
    echo "ADMIN_TOKEN is not configured. Edit .env or rerun ./supportctl install before starting the stack." >&2
    exit 1
  fi
  echo "$ADMIN_TOKEN"
}

compose() {
  docker compose --env-file "$ENV_FILE" "$@"
}

random_token() {
  if command -v openssl >/dev/null 2>&1; then
    openssl rand -hex 32
    return
  fi
  date +%s%N | sha256sum | awk '{print $1}'
}

cmd_install() {
  if [[ ! -f "$ENV_FILE" ]]; then
    cp "$ROOT_DIR/.env.example" "$ENV_FILE"
    token="$(random_token)"
    tmp="${ENV_FILE}.tmp"
    sed "s/^ADMIN_TOKEN=.*/ADMIN_TOKEN=${token}/" "$ENV_FILE" > "$tmp"
    mv "$tmp" "$ENV_FILE"
    echo "Created .env from .env.example and generated ADMIN_TOKEN."
    echo "Edit .env, especially APP_BASE_URL and Postal/MySQL passwords, then run ./supportctl up."
    return
  fi
  echo ".env already exists. Nothing changed."
}

cmd_up() {
  require_env
  compose up -d --build
}

cmd_down() {
  require_env
  compose down
}

cmd_status() {
  require_env
  compose ps
  echo
  echo "Health:"
  curl -fsS "$(base_url)/healthz" || true
  echo
  echo "Readiness:"
  curl -fsS "$(base_url)/readyz" || true
  echo
}

cmd_logs() {
  require_env
  if [[ $# -gt 0 ]]; then
    compose logs -f "$1"
  else
    compose logs -f
  fi
}

cmd_backup() {
  require_env
  mkdir -p "$ROOT_DIR/backups"
  ts="$(date +%Y%m%d-%H%M%S)"
  echo "Writing database backup to backups/mysql-${ts}.sql"
  compose exec -T mysql sh -c 'MYSQL_PWD="$MYSQL_ROOT_PASSWORD" mysqldump -uroot --single-transaction --routines --triggers "$MYSQL_DATABASE"' > "$ROOT_DIR/backups/mysql-${ts}.sql"
  echo "Backup complete."
}

api_curl() {
  local method="$1"
  local path="$2"
  local body="${3:-}"
  if [[ -n "$body" ]]; then
    curl -fsS -X "$method" "$(base_url)$path" \
      -H "Authorization: Bearer $(admin_token)" \
      -H "Content-Type: application/json" \
      --data "$body"
  else
    curl -fsS -X "$method" "$(base_url)$path" \
      -H "Authorization: Bearer $(admin_token)"
  fi
}

json_escape() {
  printf '%s' "$1" | sed 's/\\/\\\\/g; s/"/\\"/g'
}

cmd_init_agent() {
  require_env
  printf "Username: "
  read -r username
  printf "Email: "
  read -r email
  printf "Password: "
  stty -echo
  read -r password
  stty echo
  echo
  if [[ -z "$username" || -z "$email" || -z "$password" ]]; then
    echo "Username, email, and password are required." >&2
    exit 1
  fi
  api_curl POST /api/v1/admin/agents/init "{\"username\":\"$(json_escape "$username")\",\"email\":\"$(json_escape "$email")\",\"password\":\"$(json_escape "$password")\"}"
  echo
}

cmd_site_create() {
  require_env
  printf "Site name: "
  read -r name
  if [[ -z "$name" ]]; then
    echo "Site name is required." >&2
    exit 1
  fi
  api_curl POST /api/v1/admin/sites "{\"name\":\"$(json_escape "$name")\"}"
  echo
}

cmd_site_list() {
  require_env
  api_curl GET /api/v1/admin/sites
  echo
}

cmd_site_code() {
  require_env
  local site_key="${1:-}"
  if [[ -z "$site_key" ]]; then
    echo "Usage: ./supportctl site code <site_key>" >&2
    exit 1
  fi
  echo "<script src=\"$(base_url)/widget.js\" data-site=\"${site_key}\"></script>"
}

main() {
  if [[ $# -lt 1 ]]; then
    usage
    exit 1
  fi

  case "$1" in
    install) shift; cmd_install "$@" ;;
    up) shift; cmd_up "$@" ;;
    down) shift; cmd_down "$@" ;;
    status) shift; cmd_status "$@" ;;
    logs) shift; cmd_logs "$@" ;;
    backup) shift; cmd_backup "$@" ;;
    init-agent) shift; cmd_init_agent "$@" ;;
    site)
      shift
      case "${1:-}" in
        create) shift; cmd_site_create "$@" ;;
        list) shift; cmd_site_list "$@" ;;
        code) shift; cmd_site_code "$@" ;;
        *) usage; exit 1 ;;
      esac
      ;;
    *) usage; exit 1 ;;
  esac
}

main "$@"
