APP_ENV=production
APP_BASE_URL=https://chat.example.com
HTTP_ADDR=:8080

MYSQL_DSN=support:support_password@tcp(mysql:3306)/support_chat?parseTime=true&charset=utf8mb4&collation=utf8mb4_unicode_ci
REDIS_ADDR=redis:6379
REDIS_PASSWORD=
REDIS_DB=0

UPLOAD_STORAGE_PATH=/data/support-chat/uploads

POSTAL_SMTP_HOST=smtp.example.com
POSTAL_SMTP_PORT=587
POSTAL_SMTP_USER=postal-user
POSTAL_SMTP_PASSWORD=change-me
POSTAL_SMTP_FROM_DOMAIN=example.com

EMAIL_UNREAD_DELAY_SECONDS=300
AGENT_SYNC_INTERVAL_SECONDS=3
EMERGENCY_DEVICE_ALIVE_SECONDS=60
EMERGENCY_EXPIRE_SECONDS=180
TZ=Asia/Shanghai
